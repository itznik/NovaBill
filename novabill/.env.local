# .env.local

# Get this free from MongoDB Atlas (Database Deployments -> Connect -> Drivers)
# Make sure to replace <db_password> with your actual password
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/novabill?retryWrites=true&w=majority"

# Generate a random string for this (e.g., use a password generator)
JWT_SECRET="your_super_secure_random_jwt_secret_key_here"

# The base URL of your app (Codespaces will give you a unique localhost URL)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
